{
  "projectId": "historyczny-rybnik",
  "databaseId": "places-prod",
  "condition": {
    "title": "Only places-prod",
    "expression": "resource.name == \"projects/historyczny-rybnik/databases/places-prod\""
  },
  "roles": {
    "placesProdApi": {
      "serviceAccount": "places-prod-api@historyczny-rybnik.iam.gserviceaccount.com",
      "includedPermissions": [
        "datastore.entities.get",
        "datastore.entities.update",
        "datastore.databases.get"
      ]
    },
    "placesProdImport": {
      "serviceAccount": "places-prod-import@historyczny-rybnik.iam.gserviceaccount.com",
      "includedPermissions": [
        "datastore.entities.get",
        "datastore.entities.list",
        "datastore.entities.create",
        "datastore.entities.update",
        "datastore.databases.get"
      ]
    },
    "placesProdBuild": {
      "serviceAccount": "places-prod-build@historyczny-rybnik.iam.gserviceaccount.com",
      "includedPermissions": ["datastore.entities.get", "datastore.entities.list"]
    }
  },
  "storage": {
    "bucket": "historyczny-rybnik-prod-files",
    "role": "placesProdStorageImport",
    "serviceAccount": "places-prod-import@historyczny-rybnik.iam.gserviceaccount.com",
    "includedPermissions": ["storage.objects.create", "storage.objects.get", "storage.objects.list"]
  },
  "storageBackup": {
    "sourceBucket": "historyczny-rybnik-prod-files",
    "destinationBucket": "historyczny-rybnik-prod-backups",
    "serviceAccount": "project-301143182490@storage-transfer-service.iam.gserviceaccount.com",
    "sourceRole": "placesProdBackupSource",
    "sourcePermissions": ["storage.buckets.get", "storage.objects.get", "storage.objects.list"],
    "destinationRole": "placesProdBackupDestination",
    "destinationPermissions": [
      "storage.buckets.get",
      "storage.objects.create",
      "storage.objects.get",
      "storage.objects.list"
    ]
  }
}
