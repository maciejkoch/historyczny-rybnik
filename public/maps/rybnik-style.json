{
  "version": 8,
  "name": "Historyczny Rybnik \u2014 Papier i ziele\u0144",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "ground",
      "type": "background",
      "paint": {
        "background-color": "#F0F1EC"
      }
    },
    {
      "id": "landcover",
      "source": "basemap",
      "source-layer": "landcover",
      "type": "fill",
      "paint": {
        "fill-color": "#DDE8D8"
      },
      "filter": [
        "in",
        "class",
        "wood",
        "grass",
        "scrub"
      ]
    },
    {
      "id": "park",
      "source": "basemap",
      "source-layer": "park",
      "type": "fill",
      "paint": {
        "fill-color": "#DDE8D8"
      }
    },
    {
      "id": "water",
      "source": "basemap",
      "source-layer": "water",
      "type": "fill",
      "paint": {
        "fill-color": "#B5CDD0"
      }
    },
    {
      "id": "buildings",
      "source": "basemap",
      "source-layer": "building",
      "type": "fill",
      "paint": {
        "fill-color": "#DADFD7"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "basemap",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#B5CDD0",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1,
          16,
          4
        ]
      }
    },
    {
      "id": "roads-outline",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "filter": [
        "!in",
        "class",
        "rail",
        "transit",
        "ferry"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#CDD3C9",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          13,
          2,
          16,
          10,
          19,
          30
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "filter": [
        "!in",
        "class",
        "rail",
        "transit",
        "ferry"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          13,
          2,
          16,
          8,
          19,
          24
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "rail"
      ],
      "paint": {
        "line-color": "#98A49A",
        "line-width": 1.2,
        "line-dasharray": [
          3,
          3
        ]
      }
    },
    {
      "id": "street-labels",
      "source": "basemap",
      "source-layer": "transportation_name",
      "type": "symbol",
      "minzoom": 13,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:pl"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:latin"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12,
        "symbol-placement": "line",
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#65736A",
        "text-halo-color": "#F0F1EC",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-labels",
      "source": "basemap",
      "source-layer": "place",
      "type": "symbol",
      "minzoom": 9,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:pl"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:latin"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 15,
        "symbol-placement": "point",
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#65736A",
        "text-halo-color": "#F0F1EC",
        "text-halo-width": 1.5
      }
    }
  ]
}
