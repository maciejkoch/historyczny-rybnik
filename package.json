{
  "name": "historyczny-rybnik",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run places:prepare && ng build && node scripts/verify-build.mjs",
    "watch": "ng build --watch --configuration development",
    "preview": "npm run build && firebase hosting:channel:deploy faza-1 --project historyczny-rybnik --expires 30d",
    "emulate": "firebase emulators:start --only hosting --config firebase.dev.json --project historyczny-rybnik",
    "deploy:dev": "node scripts/places/deploy-dev.mjs",
    "deploy:prod": "node scripts/places/deploy-prod.mjs",
    "places:prepare": "node scripts/places/prepare.mjs",
    "places:import": "node scripts/places/import.mjs",
    "places:snapshot": "node scripts/places/snapshot.mjs",
    "test": "npm run check:contracts && npm run test:privacy && npm --prefix functions test && npm run test:research",
    "test:emulator": "firebase emulators:exec --config firebase.backend.dev.json --project demo-historyczny-rybnik --only firestore,storage \"npm --prefix functions run test:emulator\"",
    "deploy:backend:dev": "firebase deploy --config firebase.backend.dev.json --project historyczny-rybnik --only functions:places-dev,firestore:places-dev,storage:places-dev,auth",
    "places:upload-assets": "node scripts/places/upload-assets.mjs",
    "check:contracts": "tsc -p tsconfig.contracts.json",
    "test:privacy": "node --test scripts/privacy/consent.test.mjs",
    "deploy:dev-1": "node scripts/places/deploy-dev.mjs dev-1",
    "deploy:dev-2": "node scripts/places/deploy-dev.mjs dev-2",
    "deploy:dev-3": "node scripts/places/deploy-dev.mjs dev-3",
    "environment": "node scripts/places/environment.mjs",
    "auth:admin": "node infra/admin-role.mjs",
    "research": "node scripts/research/cli.mjs",
    "research:view": "node scripts/research/viewer/server.mjs",
    "test:research": "node --test scripts/research/test/*.test.mjs"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-server": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/ssr": "22.2.5",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "firebase": "12.19.0",
    "maplibre-gl": "6.16.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^20.17.19",
    "daisyui": "5.7.50",
    "firebase-tools": "15.35.0",
    "postcss": "8.5.32",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.4",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@firebase/app": "0.16.2"
  }
}
