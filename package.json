{
  "name": "historyczny-rybnik",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/verify-build.mjs",
    "watch": "ng build --watch --configuration development",
    "preview": "npm run build && firebase hosting:channel:deploy faza-1 --project historyczny-rybnik --expires 30d",
    "emulate": "firebase emulators:start --only hosting --project historyczny-rybnik",
    "deploy:dev": "npm run build && firebase deploy --only hosting --config firebase.dev.json --project historyczny-rybnik",
    "deploy:prod": "npm run build && firebase deploy --only hosting --config firebase.json --project historyczny-rybnik"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-server": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/ssr": "22.2.5",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "maplibre-gl": "6.16.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^20.17.19",
    "daisyui": "5.7.50",
    "firebase-tools": "15.35.0",
    "postcss": "8.5.32",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.4",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
